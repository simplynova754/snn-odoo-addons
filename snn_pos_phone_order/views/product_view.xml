<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_snn_short_name" model="ir.ui.view">
        <field name="name">product.template.form.snn.short.name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pos']/field[@name='to_weight']" position="before">
                <field name="snn_pos_short_name" placeholder="e.g. Norwegian SW"/>
                <field name="snn_pos_top_seller"/>
            </xpath>
        </field>
    </record>
</odoo>
