<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li[hasclass('price-per-unit')]" position="before">
            <li t-if="line.snnOptions and line.snnOptions.length" class="snn-options">
                <div class="snn-option snn-option-base">
                    <span>Base</span>
                    <span t-if="!props.basic_receipt" class="snn-option-price" t-esc="line.snnBasePrice"/>
                </div>
                <div t-foreach="line.snnOptions" t-as="opt" t-key="opt_index"
                     class="snn-option" t-att-class="{ 'snn-option-missing': opt.missing }">
                    <span t-esc="opt.name"/>
                    <span t-if="opt.extra and !props.basic_receipt" class="snn-option-price" t-esc="opt.extra"/>
                </div>
            </li>
        </xpath>
    </t>
</templates>
